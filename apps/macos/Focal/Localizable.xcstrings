    "Photos are copied to Year / Date folders, for example 2026/2026-10-02." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真は 年 / 日付 のフォルダ（例: 2026/2026-10-02）にコピーされます。"
          }
        }
      }
    },
    "Photos imported from a card are copied to Year / Date folders (for example 2026/2026-10-02) inside this folder." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードから取り込んだ写真は、このフォルダの中の 年 / 日付 のフォルダ（例: 2026/2026-10-02）にコピーされます。"
          }
        }
      }
    },
    "Photos on the card are never moved or deleted." : {
      "localizations" : {
        "ja" : {
