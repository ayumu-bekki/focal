      }
    },
    "The destination has %@ free; the card holds %@. Photos already imported are skipped, but there may not be enough space." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み込み先の空き容量は %1$@、カードのデータ量は %2$@ です。取り込み済みの写真はスキップされますが、空き容量が不足する可能性があります。"
          }
        }
      }
    },
    "The files were copied, but could not be added to the catalog. Rescan the destination folder to add them." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルはコピーされましたが、カタログへの登録に失敗しました。読み込み先フォルダを再スキャンして登録してください。"
          }
        }
      }
    },
    "The integrity check found a problem with the catalog. A backup of a damaged catalog counts toward the number of backups kept, so older, good backups may be deleted." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カタログの整合性チェックで問題が検出されました。破損したカタログのバックアップも保持世代数としてカウントされるため、過去の正常なバックアップが削除される可能性があります。"
          }
        }
      }
    },
    "The integrity check found a problem with the catalog. A backup of a damaged catalog counts toward the number of backups kept, so older, good backups may be deleted.\n%@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カタログの整合性チェックで問題が検出されました。破損したカタログのバックアップも保持世代数としてカウントされるため、過去の正常なバックアップが削除される可能性があります。\n%@"
          }
        }
      }
    },
    "The last backup was %lld days ago." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
