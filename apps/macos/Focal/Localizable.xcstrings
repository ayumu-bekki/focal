      }
    },
    "The saved edits, ratings, flags, tags and album memberships of %lld photos (%lld with edits) are deleted for good. A backup of the catalog is made first." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管されている %lld 枚（うち現像設定あり %lld 枚）の現像設定・★・フラグ・タグ・アルバム所属を完全に削除します。実行前にカタログのバックアップを作成します。"
          }
        }
      }
    },
    "These settings are saved in this catalog. Photos imported from a card are copied to Year / Date folders (for example 2026/2026-10-02) inside the import destination." : {
