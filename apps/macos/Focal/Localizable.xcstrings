        }
      }
    },
    "Photos shown in the viewer are kept here so they appear instantly next time. When the limit is exceeded, the least recently used previews are removed." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビューアで表示した写真の現像結果をここに保存し、次に開いたときすぐに表示します。上限を超えると、最後に使った日時が古いものから削除します。"
          }
        }
      }
    },
