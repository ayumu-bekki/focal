  "strings" : {
    "" : {

    },
    "“%@” is not a Focal catalog." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” は Focal のカタログではありません。"
          }
        }
      }
    },
    "“%@” is not connected." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” は接続されていません。"
          }
        }
      }
    },
    "%lld" : {

    },
    "%lld / %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld / %2$lld"
          }
        }
      }
    },
    "%lld photos are already missing from the disk; only their catalog entries are removed." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚はディスクにすでにないため、カタログの情報だけを削除します。"
          }
        }
      }
    },
    "%lld photos are on a network volume. They are deleted immediately and permanently, and cannot be recovered from the Trash." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚はネットワークボリュームにあります。すぐに完全に削除され、ゴミ箱から戻すことはできません。"
          }
        }
      }
    },
    "%lld photos could not be imported." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚は取り込めませんでした。"
          }
        }
      }
    },
    "%lld photos have no capture time, so the file’s modified date was used (estimated)." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚は撮影日時がないため、ファイルの更新日で日付を決めました（推定）。"
          }
        }
      }
    },
    "%lld photos were already imported and skipped." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚は取り込み済みなのでスキップしました。"
          }
        }
      }
    },
