{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "“%@” is not a Focal catalog." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” は Focal のカタログではありません。"
          }
        }
      }
    },
    "“%@” is not connected." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” は接続されていません。"
          }
        }
      }
    },
    "%@ free of %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 中 %1$@ 空き"
          }
        }
      }
    },
    "%lld" : {

    },
    "%lld / %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld / %2$lld"
          }
        }
      }
    },
    "%lld files, %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ファイル、%@"
          }
        }
      }
    },
    "%lld folders in the catalog are inside another folder of the catalog, so the same photos may be registered twice. Merging combines them into one, keeping edits, ratings, flags and tags. A backup of the catalog is made first." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カタログ内に、別の登録フォルダに含まれているフォルダが %lld 個あり、同一の写真が二重登録されている可能性があります。統合を実行すると、現像設定・★・フラグ・タグを維持したまま 1 つにまとめられます（実行前にカタログのバックアップを作成します）。"
          }
        }
      }
    },
    "%lld folders, %lld subfolders" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ %lld 個、サブフォルダ %lld 個"
          }
        }
      }
    },
    "%lld photos" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚"
          }
        }
      }
    },
    "%lld photos (%lld with edits)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚（うち現像の設定あり %lld 枚）"
          }
        }
      }
    },
    "%lld photos (RAW %lld, other %lld)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚（RAW %lld、RAW 以外 %lld）"
          }
        }
      }
    },
    "%lld photos are already missing from the disk; only their catalog entries are removed." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚はすでにディスク上に見つからないため、カタログの登録情報のみを削除します。"
          }
        }
      }
    },
    "%lld photos are on a network volume. They are deleted immediately and permanently, and cannot be recovered from the Trash." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚はネットワークボリューム上の写真です。ゴミ箱を経由せず即座に完全削除され、復元することはできません。"
          }
        }
      }
    },
    "%lld photos could not be imported." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚は取り込めませんでした。"
          }
        }
      }
    },
    "%lld photos have edits, ratings, flags or tags. They are kept in this catalog and come back when you add the same photos again. Optimize Catalog deletes them for good. The files on disk are not deleted." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚の写真に現像設定・★・フラグ・タグが設定されています。これらはカタログ内に保管され、同じ写真を再登録すると復元されます。「カタログを最適化」を実行すると完全に削除されます（ディスク上の実ファイルは削除されません）。"
          }
        }
      }
    },
    "%lld photos have no capture time, so the file’s modified date was used (estimated)." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚は撮影日時情報がないため、ファイルの更新日時を使用しました（推定）。"
          }
        }
      }
    },
    "%lld photos were already imported and skipped." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 枚は取り込み済みのためスキップしました。"
          }
        }
      }
    },
    "%lld photos, %@" : {
      "localizations" : {
        "ja" : {
