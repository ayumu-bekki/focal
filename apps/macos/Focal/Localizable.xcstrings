            "value" : "新しい %lld 個"
          }
        }
      }
    },
    "The photos and their JPEG, video and sidecar files with the same name (%lld files) will be deleted from the disk." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
